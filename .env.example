# Bungie API - Register at https://www.bungie.net/en/Application
BUNGIE_API_KEY=your_api_key
BUNGIE_CLIENT_ID=your_client_id
BUNGIE_CLIENT_SECRET=your_client_secret

# Cookie encryption - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=your_32_byte_hex_string

# Fallback site URL for local dev when request headers are unavailable.
# In production, OAuth uses the domain you actually visit (e.g. lightledger.officiallysp.net).
SITE_URL=http://localhost:8888
